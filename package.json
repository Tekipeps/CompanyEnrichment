    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.18.0",
    "prisma": "^7.4.2",
    "typescript": "^5.4.5"
  },
