# ── Required ──────────────────────────────────────────────────────────────────

# xAI — used for domain resolution + company intelligence synthesis (grok-4-1-fast-non-reasoning)
XAI_API_KEY=

# Exa — used for parallel web searches (profile, funding, personnel)
EXA_API_KEY=

# PostgreSQL connection string (Prisma) — used for enrichment cache
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Optional ──────────────────────────────────────────────────────────────────

# HTTP server port (default: 3000)
PORT=3000

# RapidAPI proxy secret — required when deployed behind the RapidAPI gateway
RAPIDAPI_PROXY_SECRET=
