// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output = "./generated"
}

datasource db {
  provider = "postgresql"
}

model CompanyEnrichment {
  id          String   @id @default(cuid())
  domain      String   @unique
  name        String?
  data        String   // JSON stringified intelligence payload
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([domain])
}

model CompanySnapshot {
  id              String   @id @default(cuid())
  domain          String
  snapshotDate    DateTime @default(now())
  headcount       String?  // raw string from firmographics.employeeCountEstimate
  jobPostingCount Int?     // count of Exa job posting results
  fundingNote     String?  // e.g. "Series C · $120M total"

  @@index([domain, snapshotDate])
}
